# Local development only. Configure secrets in Render for production.
# Optional locally; defaults to backend/backend/data/agro.sqlite.
# DATABASE_PATH=/absolute/path/to/agro.sqlite
JWT_SECRET=replace-with-a-random-secret-of-at-least-32-bytes
ADMIN_EMAIL=owner@example.com
ADMIN_NAME=Administrator
# Keep this configured on Render so a fresh database can recreate the administrator. Minimum 12 characters, max 72 bytes.
ADMIN_PASSWORD=replace-with-a-unique-long-password
PORT=5000
FRONTEND_URL=http://localhost:5173
# Optional locally; Render uses temporary storage; uploaded pictures can be lost.
# UPLOAD_DIR=/absolute/path/to/profile-pictures
EMAIL_HOST=smtp.example.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=owner@example.com
EMAIL_PASS=replace-with-provider-credential
EMAIL_FROM=Agro Livestock <owner@example.com>

# Seed fictional farms and records once per empty database; false starts blank.
SEED_DEMO_DATA=true
